APP_ENV=development
APP_SECRET_KEY=replace-me-before-sharing
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://127.0.0.1:5173

# Portable PostgreSQL runs on 55432 to avoid colliding with a system service.
DATABASE_URL=postgresql+psycopg://olistops:olistops@127.0.0.1:55432/olistops
WORKSPACE_ROOT=./workspace

MODEL_DEFAULT_PROFILE=local_lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODELS=./models/ollama
CLOUD_API_BASE=
CLOUD_API_KEY=
CLOUD_MODEL_NAME=

EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_RRF_K=60
RETRIEVAL_FTS_WEIGHT=0.75
RETRIEVAL_VECTOR_WEIGHT=0.25
RERANKER_ENABLED=false

MAX_AGENT_STEPS=10
MAX_TOOL_CALLS=8
MAX_RUN_SECONDS=120
MAX_RESULT_ROWS=500
MAX_UPLOAD_MB=20
TRACE_CONTENT_MODE=redacted
